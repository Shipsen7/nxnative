<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition=" '$(ExtraDefineConstants)' != '' ">$(DefineConstants);$(ExtraDefineConstants)</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);._*</DefaultItemExcludes>
    <!-- NXNative uses only these unchanged helpers from the vendored source.
         Do not compile emulator UI, OS process helpers or unrelated serializers. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Memory/IArray.cs" />
    <Compile Include="Memory/StructArrayHelpers.cs" />
    <Compile Include="Utilities/BitUtils.cs" />
    <Compile Include="Utilities/BitfieldExtensions.cs" />
    <Compile Include="Pools/ObjectPool.cs" />
  </ItemGroup>

</Project>
